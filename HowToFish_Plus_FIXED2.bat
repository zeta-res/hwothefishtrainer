@echo off
setlocal EnableExtensions
title HOW TO FISH - PLUS
color 0B
set "WORK=%TEMP%\HowToFishTrainer"
if not exist "%WORK%" md "%WORK%" >nul 2>&1

rem ---- her calistirma icin benzersiz klasor (mkdir atomiktir) ----
set "TRY=0"
:htf_tag
set /a TRY+=1
set "RUN=%WORK%\%RANDOM%%RANDOM%%RANDOM%"
2>nul mkdir "%RUN%"
if not errorlevel 1 goto htf_go
if %TRY% LSS 30 goto htf_tag
echo   [!] Gecici klasor olusturulamadi: %WORK%
pause
exit /b 1

:htf_go
copy /y "%~f0" "%RUN%\pkg.bat" >nul 2>&1
if not exist "%RUN%\pkg.bat" (
  echo   [!] Gecici klasore kopyalanamadi: %RUN%
  echo       Cozum: bu dosyayi C:\ altinda bir klasore tasiyip tekrar dene.
  pause
  exit /b 1
)
where powershell >nul 2>&1
if errorlevel 1 (
  echo   [!] PowerShell bulunamadi.
  pause
  exit /b 1
)
echo   HOW TO FISH PLUS baslatiliyor...
> "%RUN%\dec.ps1" echo $ErrorActionPreference='Stop'
>> "%RUN%\dec.ps1" echo $raw=[IO.File]::ReadAllText('%RUN%\pkg.bat')
>> "%RUN%\dec.ps1" echo $i=$raw.IndexOf('#:PAYLOAD#')
>> "%RUN%\dec.ps1" echo if($i -lt 0){exit 3}
>> "%RUN%\dec.ps1" echo $sb=New-Object System.Text.StringBuilder
>> "%RUN%\dec.ps1" echo foreach($l in ($raw.Substring($i) -split [char]10)){if($l.StartsWith('#:B64:')){[void]$sb.Append($l.Substring(6).Trim())}}
>> "%RUN%\dec.ps1" echo [IO.File]::WriteAllBytes('%RUN%\core.ps1',[Convert]::FromBase64String($sb.ToString()))
>> "%RUN%\dec.ps1" echo exit 0
powershell -NoProfile -ExecutionPolicy Bypass -File "%RUN%\dec.ps1"
if errorlevel 1 (
  echo   [!] Paket cozulemedi. Teshis: HowToFish_Plus.bat -SelfTest
  pause
  exit /b 2
)
powershell -NoProfile -ExecutionPolicy Bypass -File "%RUN%\core.ps1" %*
set "RC=%ERRORLEVEL%"
if not "%RC%"=="0" (
  echo.
  echo   [!] Cikis kodu: %RC%
  echo       Teshis icin:  HowToFish_Plus.bat -SelfTest
  pause
)
rd /s /q "%RUN%" >nul 2>&1
endlocal & exit /b %RC%

